# Agent Orchestrator Environment Configuration

# HTTP server port
PORT=8082

# WeChat Bridge WebSocket URL
WECHAT_BRIDGE_WS=ws://localhost:8080

# Default AI provider (anthropic, zypher, openclaw)
DEFAULT_AI_PROVIDER=anthropic

# ============================================================================
# Unified AI Configuration
# All providers use the same API key and base URL
# ============================================================================
AI_API_KEY=your_api_key_here
AI_BASE_URL=https://api.anthropic.com
AI_MODEL=claude-3-5-sonnet-20241022
AI_MAX_TOKENS=1024

# ============================================================================
# Provider-Specific Settings
# ============================================================================
# Zypher Configuration
ZYPHER_ENABLED=false

# OpenClaw Configuration
OPENCLAW_ENABLED=false
OPENCLAW_ENDPOINT=http://localhost:3000
