# WeChat Bridge Environment Configuration

# WebSocket server port for communication with web app
WS_PORT=8080

# HTTP server port for health checks
HTTP_PORT=8081

# Wechaty puppet type (wechat, padlocal, etc.)
PUPPET_TYPE=wechat

# For PadLocal puppet (more stable, requires token)
# Get token from: http://pad-local.com/
# WECHATY_PUPPET_PADLOCAL_TOKEN=your_token_here

# Log level (silly, verbose, info, warn, error)
LOG_LEVEL=info
