{
  "name": "realchat",
  "productName": "RealChat",
  "version": "1.0.0",
  "description": "AI-powered WeChat assistant with Claude integration",
  "main": "electron/main.js",
  "author": "RealChat Team",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:backend": "python3 app_consolidated.py",
    "build": "npm run build:frontend && npm run build:electron",
    "build:frontend": "cd frontend && npm run build",
    "build:electron": "electron-builder --mac",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "dependencies": {
    "electron-log": "^5.1.7",
    "electron-store": "^8.2.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "electron": "^29.4.6",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.realchat.app",
    "productName": "RealChat",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "venv/**/*",
      "app_consolidated.py",
      "services/**/*",
      "core/**/*",
      "utils/**/*",
      "modules/**/*",
      "agent-orchestrator/**/*",
      "agent.py",
      "requirements.txt",
      "requirements_consolidated.txt",
      "ai_settings.json",
      "node_modules/**/*",
      "!node_modules/**/node_modules",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "scripts",
        "to": "scripts",
        "filter": ["**/*"]
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "dmg": {
      "title": "RealChat",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}
