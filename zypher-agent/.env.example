# Zypher Agent Configuration

# Port for Zypher Agent HTTP server
ZYPHER_PORT=8000

# Optional: Override AI settings (if not using ai_settings.json from parent directory)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Note: By default, Zypher Agent will read from ../ai_settings.json
# which is shared with the Flask backend. Only set these environment
# variables if you want to use different settings for Zypher.

# Optional: Firecrawl for web crawling capabilities
# FIRECRAWL_API_KEY=your_firecrawl_api_key_here
