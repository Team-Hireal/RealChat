# RealChat - Consolidated Deployment
FROM python:3.11-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    tesseract-ocr \
    tesseract-ocr-chi-sim \
    tesseract-ocr-chi-tra \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements
COPY requirements_consolidated.txt requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code
COPY app_consolidated.py app.py
COPY services/ services/
COPY core/ core/
COPY modules/ modules/
COPY scripts/ scripts/
COPY .env .env

# Copy frontend (if built)
COPY frontend/dist/ frontend/dist/

# Create data directory
RUN mkdir -p /app/data /app/logs

# Expose port
EXPOSE 5001

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD python -c "import requests; requests.get('http://localhost:5001/api/health')"

# Run application
CMD ["gunicorn", "--worker-class", "eventlet", "-w", "1", "--bind", "0.0.0.0:5001", "app:app"]
