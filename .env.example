# RealChat Environment Configuration
# Copy this file to .env and fill in your values

# ============================================================================
# General Configuration
# ============================================================================
NODE_ENV=production
FLASK_ENV=production

# ============================================================================
# AI Provider Selection
# Choose: anthropic, zypher, or openclaw
# ============================================================================
DEFAULT_AI_PROVIDER=anthropic

# ============================================================================
# Unified AI Configuration
# All providers use the same API key and base URL
# Get your API key from: https://console.anthropic.com/
# ============================================================================
AI_API_KEY=your_api_key_here
AI_BASE_URL=https://api.anthropic.com
AI_MODEL=claude-3-5-sonnet-20241022
AI_MAX_TOKENS=1024

# ============================================================================
# Legacy Configuration (Deprecated - use AI_API_KEY instead)
# These are kept for backward compatibility
# ============================================================================
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# ZYPHER_API_KEY=your_zypher_api_key_here
# OPENCLAW_API_KEY=your_openclaw_api_key_here

# ============================================================================
# Provider-Specific Settings
# ============================================================================
# Zypher Agents
ZYPHER_ENABLED=false

# OpenClaw Local Instance
OPENCLAW_ENABLED=false
OPENCLAW_ENDPOINT=http://localhost:3000

# ============================================================================
# WeChat Configuration
# ============================================================================
# For PadLocal puppet (more stable, requires paid token)
# Get token from: http://pad-local.com/
# WECHATY_PUPPET_PADLOCAL_TOKEN=your_token_here

# ============================================================================
# Web Application Settings
# ============================================================================
WEB_APP_PORT=5001
WEB_APP_SECRET_KEY=change_this_to_a_random_secret_key
