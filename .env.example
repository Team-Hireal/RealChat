# RealChat Configuration
# Copy this file to .env and fill in your values

# Flask Configuration
FLASK_ENV=development
FLASK_PORT=5001
SECRET_KEY=change-this-to-a-random-secret-key

# AI Provider (Anthropic Claude)
# Get your API key from: https://console.anthropic.com/
AI_API_KEY=your-anthropic-api-key-here
AI_BASE_URL=https://api.anthropic.com
AI_MODEL=claude-sonnet-4-5-20250929
AI_MAX_TOKENS=1024

# WeChat Configuration
# Comma-separated list of chat names to monitor
# Note: Use "File" to search for "File Transfer" - it's more reliable
WECHAT_CHAT_NAMES=File Transfer,文件传输助手
# Scan method: applescript, ocr, or manual
WECHAT_SCAN_METHOD=applescript

# Agent Configuration
# Auto-start agent when application starts
AGENT_AUTO_START=false
# Seconds between message checks (1 second for faster response)
AGENT_MONITOR_INTERVAL=1

# Storage
STORAGE_PATH=./data
LOG_LEVEL=INFO
